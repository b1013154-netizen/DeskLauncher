{
  "name": "desk-launcher",
  "productName": "DeskLauncher",
  "version": "1.0.0",
  "description": "デスクトップに置けるボタン型ショートカットランチャー",
  "main": "src/main.js",
  "author": "takuya",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/actions.js && node --check src/win32.js && node --check src/config.js && node --check src/icons.js && node --check src/preload.js && node scripts/test-config.js",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.b1013154netizen.desklauncher",
    "productName": "DeskLauncher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/tray.png",
      "package.json",
      "!**/node_modules/koffi/build/koffi/{darwin_*,linux_*,freebsd_*,openbsd_*,musl_*,win32_arm64,win32_ia32}/**",
      "!**/node_modules/koffi/{src,doc,vendor}/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DeskLauncher",
      "artifactName": "DeskLauncher-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "DeskLauncher-Portable-${version}.exe"
    },
    "extraResources": [
      {
        "from": "docs",
        "to": "docs"
      }
    ],
    "electronLanguages": [
      "ja",
      "en-US"
    ]
  }
}
